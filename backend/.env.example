MYSQL_ROOT_PASSWORD=change-this-root-password
DB_USERNAME=pork_user
DB_PASSWORD=123456
REDIS_PASSWORD=change-this-redis-password
REDIS_DATABASE=0
NACOS_NAMESPACE=
RABBITMQ_USERNAME=pork
RABBITMQ_PASSWORD=change-this-rabbit-password
JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
FILE_STORAGE_PATH=./data/trace-files
SLAUGHTERHOUSE_NAME=默认定点屠宰场

# ========== 区块链上链（blockchain-service） ==========
# evm=真实上链（EVM 兼容链）；local=数据库模拟账本（仅开发调试）
BLOCKCHAIN_TYPE=evm
# 本地 Ganache（docker-compose 内置）：http://ganache:8545，链 ID 1337
# Sepolia 测试网：https://rpc.sepolia.org，链 ID 11155111（私钥需自备并从水龙头领测试币）
EVM_RPC_URL=http://ganache:8545
EVM_CHAIN_ID=1337
# 上链账户私钥。默认值为 Ganache --wallet.deterministic 首个账户，仅限本地开发链，切勿用于公网
EVM_PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d
# 已部署的 PorkTraceability 合约地址；留空则服务启动时自动部署（地址见服务日志），部署后建议回填固定
EVM_CONTRACT_ADDRESS=
