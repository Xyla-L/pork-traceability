<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 1. 继承父工程，获取所有版本管理和依赖声明 -->
    <parent>
        <groupId>com.pork</groupId>
        <artifactId>backend</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>gateway-service</artifactId>
    <packaging>jar</packaging>
    <description>API 网关服务</description>

    <dependencies>
        <!-- 2. 核心依赖：Spring Cloud Gateway -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>

        <!-- Compose and operations probe /actuator/health. Keep the gateway
             on the reactive WebFlux stack by using Actuator without MVC. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 3. 服务发现：Nacos Discovery -->
        <!-- 同样，版本由父工程的 spring-cloud-alibaba-dependencies 管理 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- 负载均衡：路由使用 lb:// 前缀时，必须引入该依赖才能把服务名解析为实例。
             Spring Cloud 2023 的 spring-cloud-starter-gateway 不会自动带上它，
             缺失时网关对 lb://xxx 直接返回 503。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- JWT 校验工具与 Redis 黑名单。 -->
        <dependency>
            <groupId>com.pork</groupId>
            <artifactId>common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>

        <!-- 5. 公共工具：引入不含 Web 依赖的 common-core -->
        <!-- 版本由父工程统一管理为 ${project.version} -->
        <dependency>
            <groupId>com.pork</groupId>
            <artifactId>common-core</artifactId>
        </dependency>

        <!-- 6. 开发工具 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <!-- 7. 构建插件 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
